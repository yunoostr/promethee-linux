#!/usr/bin/env bash
# Starts Promethee for Linux.
# First run: builds it. Later runs: start right away, and update in the background
# when Promethee ships a new release (used from the next launch on).
set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
REPO=promethee-io/Promethee-releases
CURRENT=$ROOT/dist/current
RETRY_FAILED_AFTER_MIN=1440   # minutes before a failed update is tried again

latest_version() {
  local url
  url=$(curl -fsSo /dev/null -w '%{redirect_url}' --max-time 10 "https://github.com/$REPO/releases/latest") || return 1
  echo "${url##*/v}"
}

notify() {
  echo "promethee-linux: $*" >&2
  if command -v notify-send >/dev/null; then notify-send -a Promethee Promethee "$*" || true; fi
}

# Builds the latest release next to the current one, switches to it, keeps the previous one
# (it may still be running) and deletes anything older.
update() {
  mkdir -p "$ROOT/build"
  exec 9>"$ROOT/build/.update.lock"
  flock -n 9 || return 0                                  # an update is already running
  local latest previous
  latest=$(latest_version) || return 0                    # offline: try at next launch
  [ -n "$latest" ] && [ "$latest" != "$(cat "$CURRENT/VERSION" 2>/dev/null)" ] || return 0
  # A failed build is retried once its marker is a day old: a broken release isn't rebuilt on
  # every launch, and a transient failure (network, full disk) doesn't block that release forever.
  [ -n "$(find "$ROOT/build/$latest.failed" -mmin -$RETRY_FAILED_AFTER_MIN 2>/dev/null)" ] && return 0
  previous=$(readlink -f "$CURRENT")

  if "$ROOT/build.sh" "$latest" > "$ROOT/build/update.log" 2>&1; then
    for dir in "$ROOT"/dist/promethee-*; do
      [ "$dir" = "$(readlink -f "$CURRENT")" ] || [ "$dir" = "$previous" ] || rm -rf "$dir"
    done
    notify "Promethee $latest is installed. Restart the app to use it."
  else
    touch "$ROOT/build/$latest.failed"
    notify "Updating to Promethee $latest failed, see $ROOT/build/update.log"
  fi
}

# Chromium's sandbox uses unprivileged user namespaces. Where the system blocks them
# (Ubuntu 23.10+ via AppArmor, hardened kernels, user.max_user_namespaces=0, containers)
# it needs its setuid helper, which only root can set up, so we ask once per build.
ensure_sandbox() {
  case " $* " in *" --no-sandbox "*) return 0 ;; esac   # sandbox turned off: nothing to set up
  if [ "$(id -u)" = 0 ]; then
    echo "Chromium won't start as root with its sandbox: run ./promethee as your usual user." >&2
    exit 1
  fi
  local helper
  helper=$(readlink -f "$CURRENT")/chrome-sandbox
  # AppArmor's restriction still lets unshare succeed (the namespace just gets no rights), hence
  # the sysctl; the probe catches everything else that blocks namespaces.
  [ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ] \
    || [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" = 0 ] \
    || { command -v unshare >/dev/null && ! unshare -Ur true 2>/dev/null; } \
    || return 0
  [ "$(stat -c %u:%a "$helper")" = 0:4755 ] && return 0

  echo "Promethee needs admin rights once to set up Chromium's sandbox."
  local fix='chown root:root "$1" && chmod 4755 "$1"'
  if command -v pkexec >/dev/null && pkexec /bin/sh -c "$fix" sh "$helper"; then return 0; fi
  if command -v sudo >/dev/null && sudo /bin/sh -c "$fix" sh "$helper"; then return 0; fi
  echo "Couldn't set up the sandbox. To start without it (less safe): ./promethee --no-sandbox" >&2
  exit 1
}

APPS=${XDG_DATA_HOME:-$HOME/.local/share}/applications
ICONS=${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor
ICON_SIZES="16 32 128 256 512"

# Lists Promethee in app launchers and lets promethee:// links open it. Rewritten when it changes
# (a moved repo fixes its Exec path); skipped when a package (AUR) already ships the entry.
install_desktop() {
  [ "${PROMETHEE_NO_DESKTOP:-}" = 1 ] && return 0
  [ -e /usr/share/applications/promethee.desktop ] && return 0
  [[ $ROOT == *[\"\`\$\\]* ]] && return 0   # can't be quoted in Exec= without desktop-file escaping
  local size src dst entry
  for size in $ICON_SIZES; do
    src=$CURRENT/resources/assets/icon.iconset/icon_${size}x${size}.png
    dst=$ICONS/${size}x${size}/apps/promethee.png
    if [ -f "$src" ] && ! cmp -s "$src" "$dst"; then mkdir -p "${dst%/*}" && cp "$src" "$dst"; fi
  done
  entry="[Desktop Entry]
Type=Application
Name=Promethee
Exec=\"$ROOT/promethee\" %U
Icon=promethee
Categories=Office;
StartupWMClass=promethee
MimeType=x-scheme-handler/promethee;"
  [ "$entry" = "$(cat "$APPS/promethee.desktop" 2>/dev/null)" ] && return 0
  mkdir -p "$APPS" && printf '%s\n' "$entry" > "$APPS/promethee.desktop"
  if command -v update-desktop-database >/dev/null; then update-desktop-database -q "$APPS"; fi
}

uninstall_desktop() {
  local size
  rm -f "$APPS/promethee.desktop"
  for size in $ICON_SIZES; do rm -f "$ICONS/${size}x${size}/apps/promethee.png"; done
  if command -v update-desktop-database >/dev/null; then update-desktop-database -q "$APPS"; fi
  echo "Promethee removed from app launchers. Set PROMETHEE_NO_DESKTOP=1 to keep it out."
}

main() {
  if [ "${1:-}" = --uninstall-desktop ]; then uninstall_desktop; return; fi
  if [ ! -e "$ROOT/build.sh" ]; then
    :   # installed by a package (AUR): the package manager builds and updates it
  elif [ ! -e "$CURRENT" ]; then
    # Same lock as update(): a second launch waits for the first build instead of starting another.
    mkdir -p "$ROOT/build"
    exec 9>"$ROOT/build/.update.lock"
    flock 9
    if [ ! -e "$CURRENT" ]; then
      echo "First run: building Promethee for Linux, this takes a few minutes."
      "$ROOT/build.sh"
    fi
    exec 9>&-   # release it: the app exec'd below would otherwise hold it and block every update
  else
    # Detached from the terminal so closing it doesn't kill an update halfway.
    ( trap '' HUP; update ) </dev/null >/dev/null 2>&1 &
  fi
  ensure_sandbox "$@"
  install_desktop 2>/dev/null || true   # a launcher entry is a nicety: never block the app over it

  # Chromium only uses the system keyring on desktops it recognizes (GNOME...). Elsewhere (sway,
  # i3, Hyprland) it falls back to no encryption, and Promethee then can't keep you signed in.
  # KDE already gets KWallet; everyone else is pointed at the Secret Service (GNOME Keyring, KeePassXC...).
  local keyring=()
  [[ ${XDG_CURRENT_DESKTOP:-} == *KDE* || " $* " == *" --password-store="* ]] || keyring=(--password-store=gnome-libsecret)
  exec "$CURRENT/promethee" "${keyring[@]}" "$@"
}

main "$@"
