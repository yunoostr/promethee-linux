# Builds Promethee on your machine from its official macOS release: the AUR hosts no Promethee code.
pkgname=promethee
pkgver=1.4.2
pkgrel=1
_commit=870a580   # the promethee-linux commit to build; publish.sh sets it
_electron=43.8.3  # the Electron inside this Promethee release; bump.sh sets it
pkgdesc='Focus session tracker, built locally from the official macOS release'
arch=(x86_64 aarch64)
url='https://github.com/yunoostr/promethee-linux'
license=(MIT LicenseRef-Promethee)
depends=(gtk3 nss alsa-lib libsecret)
makedepends=(git unzip 'nodejs>=22.12' asar node-gyp python make gcc)
optdepends=('gnome-keyring: stay signed in outside GNOME and KDE'
            'xorg-xprop: window tracking on X11'
            'xorg-xwininfo: window tracking on X11')
options=(!strip !debug)
_releases=https://github.com/promethee-io/Promethee-releases/releases/download/v$pkgver
_electron_dl=https://github.com/electron/electron/releases/download/v$_electron
source=("promethee-linux::git+$url.git#commit=$_commit"
        "$_releases/Promethee-$pkgver-arm64.zip"
        "https://electronjs.org/headers/v$_electron/node-v$_electron-headers.tar.gz")
source_x86_64=("$_electron_dl/electron-v$_electron-linux-x64.zip")
source_aarch64=("$_electron_dl/electron-v$_electron-linux-arm64.zip")
noextract=("Promethee-$pkgver-arm64.zip"
           "electron-v$_electron-linux-x64.zip"
           "electron-v$_electron-linux-arm64.zip")
sha256sums=('SKIP'
            '3c3a7c5bface8fb9cb61de3aec80dcb33b9e9a41304d30acd9ea5587f142ab04'
            'd23630d0b98161bec7860dcc482187aca380b1e0da264c1ed5efb42bce79d604')
sha256sums_x86_64=('73d7d6fe120c998db75834c23c8ce7ce8390607c198b2e167a28acd7937bef22')
sha256sums_aarch64=('b814ab22abf0bce90fd2fffc1490efc94f388353bcdb2f744950744998fd97b1')

build() {
  cd promethee-linux
  PROMETHEE_SOURCES="$srcdir" ./build.sh "$pkgver"
}

package() {
  cd promethee-linux
  local lib=/usr/lib/promethee size
  install -d "$pkgdir$lib/dist/current"
  cp -a dist/current/. "$pkgdir$lib/dist/current/"
  chmod 4755 "$pkgdir$lib/dist/current/chrome-sandbox"
  install -Dm755 promethee "$pkgdir$lib/promethee"
  install -d "$pkgdir/usr/bin"
  ln -s "$lib/promethee" "$pkgdir/usr/bin/promethee"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/promethee.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Promethee
Exec=promethee %U
Icon=promethee
Categories=Office;
StartupWMClass=promethee
MimeType=x-scheme-handler/promethee;
DESKTOP
  for size in 16 32 128 256 512; do
    install -Dm644 "dist/current/resources/assets/icon.iconset/icon_${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/promethee.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  echo "Promethee is proprietary software owned by its authors: $url#legal" |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Promethee"
}
